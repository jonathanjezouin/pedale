{
  "name": "@pedale/game",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "description": "Pédale — client de jeu (rendu PixiJS + interface HTML, empaqueté avec Electron pour Steam)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "electron": "vite build && electron .",
    "dist": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@pedale/sim": "*",
    "pixi.js": "^8.9.0",
    "@pedale/parcours": "*"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pedale.game",
    "productName": "Pédale",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
